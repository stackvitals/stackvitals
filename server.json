{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.stackvitals/stackvitals",
  "title": "StackVitals",
  "description": "Known flaky tests, failing and slow CI, review flow, delivery and dependency risk from kept history.",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "stackvitals",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--tools",
          "value": "all"
        }
      ]
    }
  ]
}
