    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "preact": "10.29.8",
    "tweetnacl": "1.0.3",
    "tweetnacl-sealedbox-js": "1.2.0",
    "typescript": "5.9.3",
    "uplot": "1.6.32"
  }
}
